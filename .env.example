# CricketVision Environment Variables
# Copy this file to .env.local for local development overrides

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Leave empty to use the default: http://localhost:5000
# Set this to your deployed backend URL when running in production,
# e.g. on Railway, Render, Heroku, etc.
# VITE_API_URL=https://your-backend-server.com

# ─── Server-side (server.js) ──────────────────────────────────────────────────
# JWT_SECRET=your_strong_random_secret_here
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/cricketvision
# PORT=5000
